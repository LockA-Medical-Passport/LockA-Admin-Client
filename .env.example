# Base URL of the locka-api backend
NEXT_PUBLIC_LOCKA_API_URL=http://localhost:4000

# Stellar network passphrase this client operates against
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Soroban RPC endpoint
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed ProviderRegistry contract ID on the network above (required to build/run)
NEXT_PUBLIC_PROVIDER_REGISTRY_CONTRACT_ID=

# Optional: production error monitoring (see docs/environments.md)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# E2E only: bypasses the Soroban write for Playwright. NEVER set this in a deployed environment.
# NEXT_PUBLIC_E2E_TEST_MODE=1
